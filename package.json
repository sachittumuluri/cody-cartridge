    "check:icons": "node scripts/check-icons.cjs",
    "check:app-privacy": "node scripts/check-app-privacy.cjs",
    "export-compliance:store": "node scripts/build-export-compliance.cjs && node scripts/check-export-compliance.cjs --source-only",
    "check:export-compliance": "node scripts/check-export-compliance.cjs",
