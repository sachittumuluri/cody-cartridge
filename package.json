    "check:manual-tasks": "node scripts/check-app-store-connect-manual-tasks.cjs",
    "content-rights:store": "node scripts/build-app-content-rights.cjs && node scripts/check-app-content-rights.cjs",
    "check:content-rights": "node scripts/check-app-content-rights.cjs",
    "check:artifact-privacy": "node scripts/check-artifact-privacy.cjs",
    "notices:store": "node scripts/build-third-party-notices.cjs",
    "init:store-env": "node scripts/init-store-env.cjs",
    "configure:store-env": "node scripts/configure-store-env.cjs",
    "check:store-env": "node scripts/check-store-env.cjs",
    "check:store-copy": "node scripts/check-store-copy.cjs",
    "copy-map:store": "node scripts/build-app-store-copy-map.cjs && node scripts/check-app-store-copy-map.cjs",
    "check:copy-map": "node scripts/check-app-store-copy-map.cjs",
    "review-brief:store": "node scripts/build-app-review-brief.cjs && node scripts/check-app-review-brief.cjs",
    "check:review-brief": "node scripts/check-app-review-brief.cjs",
    "check:site": "node scripts/check-store-site.cjs",
    "archive:site": "node scripts/build-public-site-archive.cjs",
    "check:site-archive": "node scripts/check-public-site-archive.cjs",
    "site:archive": "npm run archive:site && npm run check:site-archive",
    "check:store-urls": "node scripts/check-store-urls.cjs",
    "check:electron-security": "node scripts/check-electron-security.cjs",
    "check:help-docs": "node scripts/check-help-docs.cjs",
    "check:release-runtime": "node scripts/check-release-runtime.cjs",
    "release:node": "node scripts/run-release-node.cjs",
    "check:release-runtime:node": "node scripts/run-release-node.cjs npm run check:release-runtime --",
    "check:release-machine": "node scripts/check-release-machine.cjs",
